# Copy this file to .env and fill in the gateway API key from TTN Console
# (Gateways > your gateway > API keys). .env is gitignored (all dotfiles are
# ignored by default except .gitignore itself), so this never gets committed.
#
# Leave this blank/unset for the very first run - see the GATEWAY_EUI_SOURCE
# comment in docker-compose.yml for the discover-EUI-then-register workflow.
TC_KEY=
